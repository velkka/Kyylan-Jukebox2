{
  "about": "Queue flows for the API parity harness, beyond single routes: guests, votes and bans together, random fill, the standby playlist in order and shuffled, hidden limits, a track pruned while queued, and restarts mid-song and mid-filler. Same format as api-routes.json, plus `setup` (the starting config and which library fixtures to copy) and actions: `player-ready` (the player has loaded, so playback starts), `delete-file`, and `restart` (a new process on the same data). Random choices are kept deterministic: random fill runs only when exactly one track hasn't played recently, and shuffle only over a one-track playlist.",
  "port": 18094,
  "clients": {
    "host": "127.0.0.1",
    "a": "192.0.2.21",
    "b": "192.0.2.22",
    "c": "192.0.2.23"
  },
  "setup": {
    "library": ["id3v24-multi.mp3", "opus.opus", "riff-info.wav", "untagged.mp3", "vorbis.ogg"],
    "config": {
      "configured": true,
      "adminPassword": "secret",
      "libraryPaths": ["{root}"],
      "perUserQueueLimit": 0,
      "downvoteSkipThreshold": 2
    }
  },
  "steps": [
    { "do": "ws-open", "client": "host" },
    { "do": "ws-open", "client": "a" },
    { "do": "player-ready" },
    { "id": "login", "ip": "host", "method": "POST", "path": "/api/login", "json": { "password": "secret" } },
    { "id": "scan", "ip": "host", "method": "POST", "path": "/api/library/scan", "admin": true },
    { "do": "wait-scan" },
    { "id": "queue-empty", "ip": "a", "method": "GET", "path": "/api/queue" },

    { "id": "a-adds-1", "ip": "a", "method": "POST", "path": "/api/queue", "json": { "trackId": 1 } },
    { "id": "b-adds-2", "ip": "b", "method": "POST", "path": "/api/queue", "json": { "trackId": 2 } },
    { "id": "c-adds-3", "ip": "c", "method": "POST", "path": "/api/queue", "json": { "trackId": 3 } },
    { "id": "a-adds-4", "ip": "a", "method": "POST", "path": "/api/queue", "json": { "trackId": 4 } },
    { "id": "queue-a", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "id": "b-downvotes", "ip": "b", "method": "POST", "path": "/api/queue/downvote" },
    { "id": "b-downvotes-again", "ip": "b", "method": "POST", "path": "/api/queue/downvote" },
    { "id": "ban-c", "ip": "host", "method": "POST", "path": "/api/bans", "admin": true, "json": { "ip": "192.0.2.23" } },
    { "id": "banned-c-still-votes", "ip": "c", "method": "POST", "path": "/api/queue/downvote" },
    { "id": "queue-c-keeps-its-song", "ip": "c", "method": "GET", "path": "/api/queue" },
    { "id": "banned-c-adds", "ip": "c", "method": "POST", "path": "/api/queue", "json": { "trackId": 5 } },
    { "id": "unban-c", "ip": "host", "method": "DELETE", "path": "/api/bans/192.0.2.23", "admin": true },
    { "id": "admin-removes-playing", "ip": "host", "method": "DELETE", "path": "/api/queue/2", "admin": true },
    { "do": "track-ended" },
    { "id": "queue-last-guest-song", "ip": "b", "method": "GET", "path": "/api/queue" },

    { "id": "random-on", "ip": "host", "method": "POST", "path": "/api/standby/settings", "admin": true, "json": { "random": true } },
    { "do": "track-ended" },
    { "id": "queue-random-fill", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "id": "a-downvotes-random-fill", "ip": "a", "method": "POST", "path": "/api/queue/downvote" },
    { "id": "stats-with-random-fill", "ip": "host", "method": "GET", "path": "/api/stats", "admin": true },
    { "id": "b-takes-over-random-fill", "ip": "b", "method": "POST", "path": "/api/queue", "json": { "trackId": 1 } },

    { "id": "standby-add-2", "ip": "host", "method": "POST", "path": "/api/standby", "admin": true, "json": { "trackId": 2 } },
    { "id": "standby-add-3", "ip": "host", "method": "POST", "path": "/api/standby", "admin": true, "json": { "trackId": 3 } },
    { "id": "standby-on", "ip": "host", "method": "POST", "path": "/api/standby/settings", "admin": true, "json": { "enabled": true } },
    { "do": "track-ended" },
    { "id": "queue-standby-first", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "id": "a-downvotes-standby", "ip": "a", "method": "POST", "path": "/api/queue/downvote" },
    { "do": "track-ended" },
    { "id": "queue-standby-second", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "do": "track-ended" },
    { "id": "queue-standby-wraps", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "id": "standby-remove-3", "ip": "host", "method": "DELETE", "path": "/api/standby/2", "admin": true },
    { "id": "shuffle-on", "ip": "host", "method": "POST", "path": "/api/standby/settings", "admin": true, "json": { "shuffle": true } },
    { "do": "track-ended" },
    { "id": "queue-shuffled", "ip": "a", "method": "GET", "path": "/api/queue" },

    { "id": "hide-limit-and-votes", "ip": "host", "method": "POST", "path": "/api/admin/settings", "admin": true, "json": { "perUserQueueLimit": -1, "downvoteSkipThreshold": -2 } },
    { "id": "a-adds-5-over-filler", "ip": "a", "method": "POST", "path": "/api/queue", "json": { "trackId": 5 } },
    { "id": "a-adds-3", "ip": "a", "method": "POST", "path": "/api/queue", "json": { "trackId": 3 } },
    { "id": "a-over-hidden-limit", "ip": "a", "method": "POST", "path": "/api/queue", "json": { "trackId": 4 } },
    { "id": "queue-a-hidden-limit", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "id": "b-downvotes-hidden", "ip": "b", "method": "POST", "path": "/api/queue/downvote" },
    { "id": "c-downvote-skips-hidden", "ip": "c", "method": "POST", "path": "/api/queue/downvote" },

    { "id": "b-adds-4", "ip": "b", "method": "POST", "path": "/api/queue", "json": { "trackId": 4 } },
    { "do": "delete-file", "file": "untagged.mp3" },
    { "id": "rescan", "ip": "host", "method": "POST", "path": "/api/library/scan", "admin": true },
    { "do": "wait-scan" },
    { "id": "rescan-status", "ip": "host", "method": "GET", "path": "/api/library/scan/status", "admin": true },
    { "id": "queue-after-prune", "ip": "b", "method": "GET", "path": "/api/queue" },
    { "id": "stats-after-prune", "ip": "host", "method": "GET", "path": "/api/stats", "admin": true },

    { "id": "votes-shown-again", "ip": "host", "method": "POST", "path": "/api/admin/settings", "admin": true, "json": { "downvoteSkipThreshold": 3 } },
    { "id": "c-adds-1", "ip": "c", "method": "POST", "path": "/api/queue", "json": { "trackId": 1 } },
    { "id": "b-adds-2-again", "ip": "b", "method": "POST", "path": "/api/queue", "json": { "trackId": 2 } },
    { "id": "a-downvotes-before-restart", "ip": "a", "method": "POST", "path": "/api/queue/downvote" },
    { "do": "ws-close" },

    { "do": "restart" },
    { "do": "ws-open", "client": "host" },
    { "do": "ws-open", "client": "a" },
    { "id": "queue-after-restart", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "id": "session-gone-after-restart", "ip": "host", "method": "GET", "path": "/api/auth", "admin": true },
    { "do": "player-ready" },
    { "id": "queue-resumed", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "id": "login-again", "ip": "host", "method": "POST", "path": "/api/login", "json": { "password": "secret" } },
    { "id": "standby-kept", "ip": "host", "method": "GET", "path": "/api/standby", "admin": true },
    { "id": "clear", "ip": "host", "method": "POST", "path": "/api/queue/clear", "admin": true },
    { "do": "track-ended" },
    { "id": "queue-filler-before-restart", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "do": "ws-close" },

    { "do": "restart" },
    { "do": "ws-open", "client": "a" },
    { "id": "queue-filler-cleared", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "do": "player-ready" },
    { "id": "queue-filler-resumed", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "id": "login-third", "ip": "host", "method": "POST", "path": "/api/login", "json": { "password": "secret" } },
    { "id": "stats-final", "ip": "host", "method": "GET", "path": "/api/stats", "admin": true },
    { "id": "stats-final-guest", "ip": "b", "method": "GET", "path": "/api/stats" },
    { "id": "fillers-off", "ip": "host", "method": "POST", "path": "/api/standby/settings", "admin": true, "json": { "enabled": false, "random": false } },
    { "do": "track-ended" },
    { "id": "queue-idle", "ip": "a", "method": "GET", "path": "/api/queue" },
    { "do": "ws-close" }
  ]
}
