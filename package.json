{
  "name": "kyylan-jukebox",
  "version": "0.2.7",
  "description": "LAN party jukebox — host plays local music, guests queue songs from their browsers",
  "author": "Kyylan",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fix-electron-macos.cjs",
    "fix-electron": "node scripts/fix-electron-macos.cjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "icons": "node scripts/gen-icons.cjs",
    "dev": "electron-vite dev",
    "build": "node scripts/gen-icons.cjs && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:win:arm64": "npm run build && electron-builder --win --arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.19.2",
    "music-metadata": "^7.14.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
